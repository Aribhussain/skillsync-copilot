{
  "name": "skillsync-copilot",
  "private": true,
  "version": "1.0.0",
  "license": "MIT",
  "description": "SkillSync Co-Pilot: AI-assisted RPL skill assessment (SIH 2026 PS 26242). Cross-platform task runner.",
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "lite": "node scripts/dev.mjs",
    "full:up": "docker compose up -d --build --wait",
    "full:smoke": "node -e \"require('child_process').execFileSync(require('path').join('backend','.venv',process.platform==='win32'?'Scripts/python.exe':'bin/python'),['scripts/smoke_full.py'],{stdio:'inherit'})\"",
    "full:down": "docker compose down",
    "test:backend": "cd backend && node -e \"require('child_process').execFileSync(require('path').join('.venv',process.platform==='win32'?'Scripts/python.exe':'bin/python'),['-m','pytest','-q'],{stdio:'inherit'})\"",
    "test:frontend": "cd frontend && npx vue-tsc -b && npx eslint . && npx vitest run",
    "test:e2e": "cd frontend && npx playwright test",
    "test": "npm run test:backend && npm run test:frontend"
  }
}
