# Copy to .env and adjust. Never commit .env.
# ---------------------------------------------------------------- backend
APP_ENV=development
# Lite mode (default): SQLite file, no install needed
DATABASE_URL=sqlite:///./storage/skillsync.db
# MySQL 8:     mysql+pymysql://skillsync:<pwd>@localhost:3306/skillsync
# SQL Server:  mssql+pyodbc://skillsync:<pwd>@localhost/skillsync?driver=ODBC+Driver+18+for+SQL+Server&TrustServerCertificate=yes
# Docker full: postgresql+pg8000://skillsync:skillsync@postgres:5432/skillsync
STORAGE_DIR=./storage
JWT_SECRET=dev-only-secret-change-me-0123456789abcdef
JWT_EXPIRE_MINUTES=720
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173
PUBLIC_APP_URL=http://localhost:5173

# Demo accounts (shown on the login screen as "demo accounts")
DEMO_PASSWORD_WORKER=worker123
DEMO_PASSWORD_ASSESSOR=assessor123
DEMO_PASSWORD_QA=qa123
DEMO_PASSWORD_ADMIN=admin123

# Mapping engine
EMBEDDINGS_ENABLED=true
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2

# Scoring / integrity
AI_GAP_THRESHOLD=2
# pHash Hamming distance for "reused photo" flags (measured; see docs/DECISIONS.md)
PHASH_HAMMING_THRESHOLD=6

# Optional Bhashini ASR adapter (activates only when set)
BHASHINI_API_KEY=
BHASHINI_USER_ID=

# Full mode adapters (Docker only)
STORAGE_BACKEND=local
QUEUE_BACKEND=background
S3_ENDPOINT=http://objectstore:8333
S3_ACCESS_KEY=skillsync
S3_SECRET_KEY=skillsync-dev-secret
S3_BUCKET=evidence
REDIS_URL=redis://valkey:6379/0

# ---------------------------------------------------------------- frontend
VITE_API_BASE=http://localhost:8000

# ---------------------------------------------------------------- e2e / screenshots
# Playwright drives a locally installed Chromium-based browser (Brave) with a
# fresh temp profile. Browsers are never downloaded locally.
PLAYWRIGHT_BROWSER_PATH=C:\Program Files\BraveSoftware\Brave-Browser\Application\brave.exe
PLAYWRIGHT_SKIP_BROWSER_DOWNLOAD=1
